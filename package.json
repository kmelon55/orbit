{
  "name": "orbit",
  "private": true,
  "version": "0.1.0",
  "description": "Private by default. File first. Agent ready.",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.16"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && pnpm build:storage",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "pnpm check && pnpm typecheck && pnpm test:unit",
    "test:unit": "tsx --test src/lib/orbit/*.test.ts src/lib/mail/*.test.ts",
    "mcp": "tsx src/mcp/server.ts",
    "migrate:obsidian": "tsx scripts/import-obsidian-vault.ts",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "test:mail-runtime": "node scripts/verify-mail-runtime.mjs",
    "storage": "tsx scripts/orbit-storage.ts",
    "build:storage": "esbuild scripts/orbit-storage.ts --bundle --platform=node --format=cjs --target=node22 --outfile=.output/orbit-storage.cjs",
    "benchmark:storage": "tsx scripts/benchmark-storage.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-start": "^1.168.48",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "google-auth-library": "^11.0.2",
    "gray-matter": "^4.0.3",
    "imapflow": "^2.0.3",
    "lucide-react": "^1.33.0",
    "lz-string": "^1.5.0",
    "mailparser": "^3.9.26",
    "nodemailer": "^10.0.10",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.7",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.132.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.2",
    "nitro": "3.0.260610-beta",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
