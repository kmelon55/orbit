# Persistent data directory: SQLite + attachments. Use an absolute path in production.
# Existing Markdown is imported once; original files are preserved.
ORBIT_VAULT_DIR=./vault

# ORBIT_DATA_DIR remains accepted as a deprecated compatibility alias.

# Required in production. Changing the password also invalidates existing sessions.
ORBIT_AUTH_USERNAME=orbit
ORBIT_AUTH_PASSWORD=replace-with-a-long-random-password

# Optional. Login is remembered for 180 days by default (maximum 365).
ORBIT_AUTH_SESSION_DAYS=180

# Optional mail integration. These can also be entered in Mail > Settings.
# Public HTTPS origin used by Gmail OAuth callbacks and Web Push.
# ORBIT_PUBLIC_URL=https://orbit.example.com
# ORBIT_GMAIL_CLIENT_ID=
# ORBIT_GMAIL_CLIENT_SECRET=
# Optional authenticated Gmail Pub/Sub push; without it Gmail polls every minute.
# ORBIT_GMAIL_PUBSUB_TOPIC=projects/PROJECT_ID/topics/orbit-mail
# ORBIT_GMAIL_PUSH_EMAIL=SERVICE_ACCOUNT@PROJECT_ID.iam.gserviceaccount.com
# Optional mail storage override; default: <vault>/.orbit/mail
# ORBIT_MAIL_DIR=/persistent/path/mail
# Optional externally managed encryption key (64 hex characters).
# Otherwise a key file is generated alongside the mail database; back up both.
# ORBIT_MAIL_ENCRYPTION_KEY=
# ORBIT_MAIL_WORKER=off
